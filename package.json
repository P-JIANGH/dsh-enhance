{
  "name": "@dsh-enhance/dsh-enhance",
  "version": "0.1.0",
  "description": "oh-my-zsh-style enhancement bundle for DeepSeek Harness (dsh-enhance): packaged skills, work-rule prompt guidance, an Enhance agent preset with a persistent deep-work prompt section, and a doctor tool — install and go",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./enhance-mode": {
      "types": "./lib/enhance-mode.d.ts",
      "default": "./lib/enhance-mode.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./client": "./client/client.js",
    "./skills/*": "./skills/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "skills",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "sync:enhance-preset": "node scripts/sync-dsh-enhance-preset.mjs",
    "test": "node --test",
    "test:gate": "node --test tests/delivery-gate.test.mjs",
    "check:pack": "node scripts/check-pack-payload.mjs",
    "qa:pack": "node qa/pack-install-drive.mjs",
    "qa:gate": "node qa/delivery-gate-drive.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.6"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-commands": "0.2.0-rc.2",
    "@deepseek-ai/dsh-goal": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-util-values": "0.2.0-rc.2",
    "@types/node": "^26.2.0",
    "typescript": "^5.9.0"
  },
  "license": "MIT",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "agent-preset",
    "skills",
    "cordis"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "homepage": "https://github.com/P-JIANGH/dsh-enhance#readme",
  "bugs": {
    "url": "https://github.com/P-JIANGH/dsh-enhance/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/P-JIANGH/dsh-enhance.git"
  }
}
